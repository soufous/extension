
{
  "manifest_version": 3,
  "name": "GitHub Keyboard Navigation",
  "version": "1.0.0",
  "description": "Naviguer sur GitHub avec le clavier",
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
